# Rendered by dev_lab.dev.ciworkflows from TOML (dev_lab/dev/ci_base.toml + [tool.dev_lab.ci] in pyproject.toml). Hand edits are refused; edit the TOML and run `python -m dev_lab.dev.ciworkflows render`.
{
  "name": "CI",
  "on": {
    "push": {
      "branches": [
        "integrate/main"
      ]
    },
    "pull_request": {
      "types": [
        "opened",
        "synchronize",
        "reopened",
        "ready_for_review"
      ]
    },
    "workflow_dispatch": {
      "inputs": {
        "smoke": {
          "description": "a merge's smoke run: the PR's part set, no promote",
          "type": "boolean",
          "default": false
        },
        "pr": {
          "description": "the pull request this run is, for a PR the job token opened (continue.yml)",
          "type": "string",
          "default": ""
        }
      }
    },
    "schedule": [
      {
        "cron": "0 2 * * *"
      }
    ]
  },
  "concurrency": {
    "group": "ci-${{ (github.event_name == 'pull_request' || inputs.pr != '') && format('pr-{0}', github.event.pull_request.number || inputs.pr) || github.run_id }}",
    "cancel-in-progress": "${{ (github.event_name == 'pull_request' || inputs.pr != '') }}"
  },
  "permissions": {
    "contents": "read"
  },
  "env": {
    "HEAD_SHA": "${{ github.event.pull_request.head.sha || github.sha }}",
    "FAMILY_SOURCE": "${{ github.server_url }}/${{ github.repository_owner }}/",
    "PARTS_EVENT": "${{ (github.event_name == 'push' || inputs.smoke || inputs.pr != '') && 'pull_request' || github.event_name }}",
    "PR_NUMBER": "${{ github.event.pull_request.number || inputs.pr }}"
  },
  "jobs": {
    "parts": {
      "env": {
        "GITHUB_TOKEN": "${{ github.token }}"
      },
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ env.HEAD_SHA }}",
            "fetch-depth": 0
          }
        },
        {
          "name": "Install uv",
          "uses": "astral-sh/setup-uv@v5",
          "with": {
            "enable-cache": true
          }
        },
        {
          "name": "Sync the environment",
          "run": "uv sync --frozen --all-extras"
        },
        {
          "id": "pending",
          "name": "Whether main still lacks the tip",
          "if": "${{ env.PARTS_EVENT != 'pull_request' && github.ref == 'refs/heads/integrate/main' }}",
          "run": "uv run --no-sync python -m dev_lab.dev.integrate pending \"$HEAD_SHA\" >> \"$GITHUB_OUTPUT\""
        },
        {
          "id": "matrix",
          "name": "The parts and their runners",
          "if": "${{ steps.pending.outputs.pending != 'false' }}",
          "run": "echo \"matrix=$(uv run --no-sync python -m dev_lab.dev.jobparts matrix --runners hosted --event \"$PARTS_EVENT\")\" >> \"$GITHUB_OUTPUT\""
        }
      ],
      "outputs": {
        "matrix": "${{ steps.matrix.outputs.matrix }}",
        "event": "${{ env.PARTS_EVENT }}",
        "pending": "${{ steps.pending.outputs.pending }}"
      },
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) }}"
    },
    "part": {
      "env": {
        "GITHUB_TOKEN": "${{ github.token }}"
      },
      "needs": "parts",
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) && (needs.parts.outputs.matrix != '') }}",
      "name": "tests/${{ matrix.part }}",
      "runs-on": "${{ matrix.runs-on }}",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ env.HEAD_SHA }}",
            "fetch-depth": 0
          }
        },
        {
          "name": "Install uv",
          "uses": "astral-sh/setup-uv@v5",
          "with": {
            "enable-cache": true
          }
        },
        {
          "name": "Sync the environment",
          "run": "uv sync --frozen --all-extras"
        },
        {
          "name": "Produce and post the part",
          "run": "uv run --no-sync python -m dev_lab.dev.jobparts produce ${{ matrix.part }}"
        }
      ],
      "permissions": {
        "contents": "write",
        "statuses": "write"
      },
      "strategy": {
        "fail-fast": false,
        "matrix": "${{ fromJSON(needs.parts.outputs.matrix) }}"
      }
    },
    "absent-parts": {
      "env": {
        "GITHUB_TOKEN": "${{ github.token }}"
      },
      "needs": [
        "parts",
        "part"
      ],
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) && (always() && needs.parts.result == 'success' && needs.parts.outputs.matrix != '') }}",
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ env.HEAD_SHA }}",
            "fetch-depth": 0
          }
        },
        {
          "name": "Install uv",
          "uses": "astral-sh/setup-uv@v5",
          "with": {
            "enable-cache": true
          }
        },
        {
          "name": "Sync the environment",
          "run": "uv sync --frozen --all-extras"
        },
        {
          "name": "Post every part no job settled",
          "run": "uv run --no-sync python -m dev_lab.dev.jobparts absent \"$HEAD_SHA\" --event \"$PARTS_EVENT\""
        }
      ],
      "permissions": {
        "contents": "read",
        "statuses": "write"
      }
    },
    "security": {
      "env": {
        "GITHUB_TOKEN": "${{ github.token }}"
      },
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) && ((github.event_name == 'pull_request' || inputs.pr != '')) }}",
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ env.HEAD_SHA }}",
            "fetch-depth": 0
          }
        },
        {
          "name": "Install uv",
          "uses": "astral-sh/setup-uv@v5",
          "with": {
            "enable-cache": true
          }
        },
        {
          "name": "Sync the environment",
          "run": "uv sync --frozen --all-extras"
        },
        {
          "name": "tests/security",
          "run": "uv run --no-sync python -m dev_lab.dev.forge security run --pr \"$PR_NUMBER\""
        }
      ],
      "permissions": {
        "contents": "read",
        "statuses": "write",
        "pull-requests": "read"
      }
    },
    "head-gates": {
      "env": {
        "GITHUB_TOKEN": "${{ github.token }}"
      },
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) && ((github.event_name == 'pull_request' || inputs.pr != '')) }}",
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ env.HEAD_SHA }}",
            "fetch-depth": 0
          }
        },
        {
          "name": "Install uv",
          "uses": "astral-sh/setup-uv@v5",
          "with": {
            "enable-cache": true
          }
        },
        {
          "name": "Sync the environment",
          "run": "uv sync --frozen --all-extras"
        },
        {
          "name": "head gates",
          "run": "uv run --no-sync python -m dev_lab.dev.forge headgate run --pr \"$PR_NUMBER\""
        }
      ],
      "permissions": {
        "contents": "read",
        "statuses": "write",
        "pull-requests": "read"
      }
    },
    "review": {
      "needs": [
        "merge-ready"
      ],
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) && (always() && (github.event_name == 'pull_request' || inputs.pr != '') && needs.merge-ready.outputs.due == 'true') }}",
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ env.HEAD_SHA }}",
            "fetch-depth": 0
          }
        },
        {
          "name": "Install uv",
          "uses": "astral-sh/setup-uv@v5",
          "with": {
            "enable-cache": false
          }
        },
        {
          "name": "Name the integration tip",
          "if": "${{ !github.event.pull_request }}",
          "run": "echo \"INTEGRATION_SHA=$(git rev-parse refs/remotes/origin/integrate/main)\" >> \"$GITHUB_ENV\""
        },
        {
          "name": "Install the review door",
          "run": "cd \"$RUNNER_TEMP\"\nexport GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=\"http.${FORGE_URL:-$GITHUB_SERVER_URL}/.extraHeader\" GIT_CONFIG_VALUE_0=\"Authorization: basic $(printf 'x-access-token:%s' \"${FAMILY_READ_TOKEN:-$GITHUB_TOKEN}\" | base64 -w0)\"\n[ -n \"$DOOR_SHA\" ] || { echo \"no commit names the door: no pull request base and no INTEGRATION_SHA\"; exit 1; }\n# A repo that locks no Python (a data repo) pins no door: the family's integration line is the door it runs.\nif ! git -C \"$GITHUB_WORKSPACE\" cat-file -e \"$DOOR_SHA:uv.lock\" 2>/dev/null; then DEV_LAB_REF=integrate/main; else\nDEV_LAB_REF=$(git -C \"$GITHUB_WORKSPACE\" show \"$DOOR_SHA:uv.lock\" | python3 -I -c 'import sys, tomllib\nlock = tomllib.loads(sys.stdin.read())\n(source,) = [p[\"source\"] for p in lock.get(\"package\", []) if p[\"name\"] == \"dev-lab\"] or sys.exit(\"the base lock pins no dev-lab\")\nif \"git\" in source:\n    print(source[\"git\"].rpartition(\"#\")[2])\nelif source.get(\"editable\") == \".\":\n    print(sys.argv[1])\nelse:\n    sys.exit(f\"dev-lab is locked from {source}, not a git revision\")' \"$DOOR_SHA\") || exit 1\nfi\ngit clone -q --no-tags --filter=blob:none --no-checkout \"${FAMILY_SOURCE}dev-lab.git\" \"$RUNNER_TEMP/dev-lab\"\ngit -C \"$RUNNER_TEMP/dev-lab\" fetch -q --no-tags origin \"$DEV_LAB_REF\"\ngit -C \"$RUNNER_TEMP/dev-lab\" checkout -q --detach FETCH_HEAD\npython3 -I -m venv \"$RUNNER_TEMP/review\" && \"$RUNNER_TEMP/review/bin/python\" -I -m pip install -q uv\n\"$RUNNER_TEMP/review/bin/uv\" export --no-config --project \"$RUNNER_TEMP/dev-lab\" --frozen --no-hashes --no-header --no-annotate --no-emit-project > \"$RUNNER_TEMP/review.txt\"\nif [ -n \"$DOOR_ONLY\" ]; then\ngrep -E \"^($DOOR_ONLY)( @ |==)\" \"$RUNNER_TEMP/review.txt\" > \"$RUNNER_TEMP/only.txt\" && [ \"$(wc -l < \"$RUNNER_TEMP/only.txt\")\" -eq \"$(echo \"$DOOR_ONLY\" | awk -F'|' '{print NF}')\" ] || { echo \"DOOR_ONLY=$DOOR_ONLY names a package the door's lock does not pin\"; exit 1; }\n\"$RUNNER_TEMP/review/bin/uv\" pip install --no-config --no-deps --python \"$RUNNER_TEMP/review/bin/python\" -r \"$RUNNER_TEMP/only.txt\"\nelse\n\"$RUNNER_TEMP/review/bin/uv\" pip install --no-config --python \"$RUNNER_TEMP/review/bin/python\" -r \"$RUNNER_TEMP/review.txt\"\nfi\n\"$RUNNER_TEMP/review/bin/uv\" pip install --no-config --python \"$RUNNER_TEMP/review/bin/python\" --no-deps \"$RUNNER_TEMP/dev-lab\"\necho \"REVIEW_PYTHON=$RUNNER_TEMP/review/bin/python\" >> \"$GITHUB_ENV\"\n",
          "env": {
            "DOOR_SHA": "${{ github.event.pull_request.base.sha || env.INTEGRATION_SHA }}",
            "FAMILY_READ_TOKEN": "${{ (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && secrets.FAMILY_READ_TOKEN || '' }}",
            "GITHUB_TOKEN": "${{ github.token }}"
          }
        },
        {
          "name": "Install the review method",
          "run": "cd \"$RUNNER_TEMP\"\nexport GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=\"http.${FORGE_URL:-$GITHUB_SERVER_URL}/.extraHeader\" GIT_CONFIG_VALUE_0=\"Authorization: basic $(printf 'x-access-token:%s' \"${FAMILY_READ_TOKEN:-$GITHUB_TOKEN}\" | base64 -w0)\"\npython3 -I -m venv \"$RUNNER_TEMP/ai-lab\" && \"$RUNNER_TEMP/ai-lab/bin/python\" -I -m pip install -q uv\nAI_LAB_REV=$(python3 -I -c 'import sys, tomllib\nlock = tomllib.loads(sys.stdin.read())\n(source,) = [p[\"source\"] for p in lock.get(\"package\", []) if p[\"name\"] == \"ai-lab\"] or sys.exit(\"the door lock pins no ai-lab\")\n\"git\" in source or sys.exit(f\"ai-lab is locked from {source}, not a git revision\")\nprint(source[\"git\"].rpartition(\"#\")[2])' < \"$RUNNER_TEMP/dev-lab/uv.lock\") || exit 1\ngit clone -q --no-tags --filter=blob:none --no-checkout \"${FAMILY_SOURCE}ai-lab.git\" \"$RUNNER_TEMP/ai-lab-src\"\ngit -C \"$RUNNER_TEMP/ai-lab-src\" fetch -q --no-tags origin \"$AI_LAB_REV\"\ngit -C \"$RUNNER_TEMP/ai-lab-src\" checkout -q --detach \"$AI_LAB_REV\"\n\"$RUNNER_TEMP/ai-lab/bin/uv\" export --no-config --project \"$RUNNER_TEMP/ai-lab-src\" --frozen --no-hashes --no-header --no-annotate --no-emit-project > \"$RUNNER_TEMP/ai-lab.txt\"\n\"$RUNNER_TEMP/ai-lab/bin/uv\" pip install --no-config --no-deps --python \"$RUNNER_TEMP/ai-lab/bin/python\" -r \"$RUNNER_TEMP/ai-lab.txt\"\n\"$RUNNER_TEMP/ai-lab/bin/uv\" pip install --no-config --no-deps --python \"$RUNNER_TEMP/ai-lab/bin/python\" \"$RUNNER_TEMP/ai-lab-src\"\n",
          "env": {
            "FAMILY_READ_TOKEN": "${{ (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && secrets.FAMILY_READ_TOKEN || '' }}",
            "GITHUB_TOKEN": "${{ github.token }}"
          }
        },
        {
          "name": "Keep the review keys in memory",
          "run": "git config --global credential.helper \"cache --timeout=1800 --socket=$RUNNER_TEMP/git-credential-cache/socket\""
        },
        {
          "name": "Hand the forge tokens to the door",
          "run": "umask 077\nmkdir -p \"$RUNNER_TEMP/forge-secrets\"\nprintf '%s' \"${FAMILY_READ_TOKEN:-$GITHUB_TOKEN}\" > \"$RUNNER_TEMP/forge-secrets/read\"\nprintf '%s' \"$GITHUB_TOKEN\" > \"$RUNNER_TEMP/forge-secrets/api\"\n",
          "env": {
            "FAMILY_READ_TOKEN": "${{ (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && secrets.FAMILY_READ_TOKEN || '' }}",
            "GITHUB_TOKEN": "${{ github.token }}"
          }
        },
        {
          "name": "tests/review",
          "run": "trap 'git credential-cache --socket=$RUNNER_TEMP/git-credential-cache/socket exit; rm -rf \"$RUNNER_TEMP/forge-secrets\"' EXIT\n\"$REVIEW_PYTHON\" -I -m dev_lab.dev.forge review run --pr ${{ github.event.pull_request.number || inputs.pr }} --keys-env AI_LAB_KEYS_PR_REVIEW --git-token-file \"$RUNNER_TEMP/forge-secrets/read\" --api-token-file \"$RUNNER_TEMP/forge-secrets/api\" --runtime \"ai_lab.python=$RUNNER_TEMP/ai-lab/bin/python\"\n",
          "env": {
            "AI_LAB_KEYS_PR_REVIEW": "${{ (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && secrets.AI_LAB_KEYS_PR_REVIEW || '' }}"
          }
        }
      ],
      "permissions": {
        "contents": "read",
        "statuses": "write",
        "pull-requests": "write",
        "issues": "write"
      }
    },
    "merge-ready": {
      "env": {
        "GITHUB_TOKEN": "${{ github.token }}"
      },
      "needs": [
        "security",
        "head-gates",
        "part",
        "absent-parts"
      ],
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) && (always() && (github.event_name == 'pull_request' || inputs.pr != '')) }}",
      "runs-on": "ubuntu-latest",
      "outputs": {
        "due": "${{ steps.ready.outputs.due }}"
      },
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ env.HEAD_SHA }}",
            "fetch-depth": 0
          }
        },
        {
          "name": "Install uv",
          "uses": "astral-sh/setup-uv@v5",
          "with": {
            "enable-cache": true
          }
        },
        {
          "name": "Sync the environment",
          "run": "uv sync --frozen --all-extras"
        },
        {
          "id": "ready",
          "name": "tests/merge-ready",
          "run": "said=\"$(uv run --no-sync python -m dev_lab.dev.forge merge ready --pr \"$PR_NUMBER\")\"; echo \"$said\"; case \"$said\" in *\"; merged\") echo \"merged=true\" >> \"$GITHUB_OUTPUT\" ;; esac; case \"$said\" in *\"; review due\"*) echo \"due=true\" >> \"$GITHUB_OUTPUT\" ;; esac"
        },
        {
          "name": "Run CI on the merged integration",
          "if": "${{ steps.ready.outputs.merged == 'true' }}",
          "run": "gh workflow run ci.yml --repo \"$GITHUB_REPOSITORY\" --ref integrate/main -f smoke=true",
          "env": {
            "GH_TOKEN": "${{ github.token }}"
          }
        }
      ],
      "permissions": {
        "contents": "write",
        "statuses": "write",
        "pull-requests": "write",
        "actions": "write"
      }
    },
    "merge-rejudge": {
      "env": {
        "GITHUB_TOKEN": "${{ github.token }}"
      },
      "needs": [
        "review"
      ],
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) && (always() && needs.review.result != 'skipped' && needs.review.result != 'cancelled') }}",
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ env.HEAD_SHA }}",
            "fetch-depth": 0
          }
        },
        {
          "name": "Install uv",
          "uses": "astral-sh/setup-uv@v5",
          "with": {
            "enable-cache": true
          }
        },
        {
          "name": "Sync the environment",
          "run": "uv sync --frozen --all-extras"
        },
        {
          "id": "ready",
          "name": "tests/merge-ready",
          "run": "said=\"$(uv run --no-sync python -m dev_lab.dev.forge merge ready --pr \"$PR_NUMBER\")\"; echo \"$said\"; case \"$said\" in *\"; merged\") echo \"merged=true\" >> \"$GITHUB_OUTPUT\" ;; esac; case \"$said\" in *\"; review due\"*) echo \"due=true\" >> \"$GITHUB_OUTPUT\" ;; esac"
        },
        {
          "name": "Run CI on the merged integration",
          "if": "${{ steps.ready.outputs.merged == 'true' }}",
          "run": "gh workflow run ci.yml --repo \"$GITHUB_REPOSITORY\" --ref integrate/main -f smoke=true",
          "env": {
            "GH_TOKEN": "${{ github.token }}"
          }
        }
      ],
      "permissions": {
        "contents": "write",
        "statuses": "write",
        "pull-requests": "write",
        "actions": "write"
      }
    },
    "promote": {
      "env": {
        "GITHUB_TOKEN": "${{ github.token }}"
      },
      "needs": [
        "parts",
        "absent-parts"
      ],
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) && (needs.parts.outputs.pending == 'true') }}",
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ env.HEAD_SHA }}",
            "fetch-depth": 0
          }
        },
        {
          "name": "Install uv",
          "uses": "astral-sh/setup-uv@v5",
          "with": {
            "enable-cache": true
          }
        },
        {
          "name": "Sync the environment",
          "run": "uv sync --frozen --all-extras"
        },
        {
          "name": "Promote main",
          "run": "uv run --no-sync python -m dev_lab.dev.integrate promote \"$HEAD_SHA\" && git push origin main"
        },
        {
          "name": "Delete the branches integration now contains",
          "if": "${{ !cancelled() }}",
          "run": "uv run --no-sync python -m dev_lab.dev.branchprune sweep"
        }
      ],
      "permissions": {
        "contents": "write",
        "statuses": "write",
        "pull-requests": "write"
      }
    }
  }
}
