# Rendered by dev_lab.dev.ciworkflows from TOML (dev_lab/dev/ci_base.toml + [tool.dev_lab.ci] in pyproject.toml). Hand edits are refused; edit the TOML and run `python -m dev_lab.dev.ciworkflows render`.
{
  "name": "Native wheels",
  "on": {
    "push": {
      "branches": [
        "main"
      ]
    },
    "workflow_dispatch": {}
  },
  "concurrency": {
    "group": "wheels-${{ github.ref }}",
    "cancel-in-progress": false
  },
  "permissions": {
    "contents": "read"
  },
  "jobs": {
    "build": {
      "name": "build ${{ matrix.target }} (${{ matrix.python }})",
      "runs-on": "${{ matrix.runner }}",
      "permissions": {
        "contents": "read",
        "id-token": "write",
        "attestations": "write",
        "artifact-metadata": "write"
      },
      "strategy": {
        "fail-fast": false,
        "matrix": {
          "include": [
            {
              "target": "linux-x86_64",
              "python": "3.12",
              "runner": "ubuntu-latest",
              "rust": "x86_64-unknown-linux-gnu",
              "manylinux": "2_28",
              "interpreter": "python3.12",
              "artifact": "wheel-linux-x86_64-cp312-abi3"
            },
            {
              "target": "windows-x86_64",
              "python": "3.12",
              "runner": "windows-latest",
              "rust": "x86_64-pc-windows-msvc",
              "manylinux": "",
              "interpreter": "python",
              "artifact": "wheel-windows-x86_64-cp312-abi3"
            },
            {
              "target": "macos-universal2",
              "python": "3.12",
              "runner": "macos-latest",
              "rust": "universal2-apple-darwin",
              "manylinux": "",
              "interpreter": "python",
              "artifact": "wheel-macos-universal2-cp312-abi3"
            }
          ]
        }
      },
      "steps": [
        {
          "uses": "actions/checkout@v4"
        },
        {
          "uses": "actions/setup-python@v5",
          "with": {
            "python-version": "${{ matrix.python }}"
          }
        },
        {
          "name": "Build the wheel",
          "uses": "PyO3/maturin-action@v1",
          "with": {
            "target": "${{ matrix.rust }}",
            "manylinux": "${{ matrix.manylinux }}",
            "args": "--release --out dist --interpreter ${{ matrix.interpreter }}"
          }
        },
        {
          "name": "The wheel is cp312-abi3",
          "shell": "bash",
          "run": "ls dist/*-cp312-abi3-*.whl || { echo 'no cp312-abi3 wheel: [tool.dev_lab.wheels] abi3 = \"3.12\" needs the extension crate to enable the pyo3 feature abi3-py312'; exit 1; }"
        },
        {
          "name": "Attest the build provenance of the wheel",
          "uses": "actions/attest-build-provenance@v4",
          "with": {
            "subject-path": "dist/*.whl"
          }
        },
        {
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "${{ matrix.artifact }}",
            "path": "dist/*.whl",
            "if-no-files-found": "error"
          }
        }
      ]
    },
    "test": {
      "name": "test ${{ matrix.target }} (${{ matrix.python }})",
      "needs": "build",
      "runs-on": "${{ matrix.runner }}",
      "strategy": {
        "fail-fast": false,
        "matrix": {
          "include": [
            {
              "target": "linux-x86_64",
              "python": "3.12",
              "runner": "ubuntu-latest",
              "artifact": "wheel-linux-x86_64-cp312-abi3"
            },
            {
              "target": "linux-x86_64",
              "python": "3.15",
              "runner": "ubuntu-latest",
              "artifact": "wheel-linux-x86_64-cp312-abi3"
            },
            {
              "target": "windows-x86_64",
              "python": "3.12",
              "runner": "windows-latest",
              "artifact": "wheel-windows-x86_64-cp312-abi3"
            },
            {
              "target": "windows-x86_64",
              "python": "3.15",
              "runner": "windows-latest",
              "artifact": "wheel-windows-x86_64-cp312-abi3"
            },
            {
              "target": "macos-universal2",
              "python": "3.12",
              "runner": "macos-latest",
              "artifact": "wheel-macos-universal2-cp312-abi3"
            },
            {
              "target": "macos-universal2",
              "python": "3.15",
              "runner": "macos-latest",
              "artifact": "wheel-macos-universal2-cp312-abi3"
            }
          ]
        }
      },
      "steps": [
        {
          "uses": "actions/setup-python@v5",
          "with": {
            "python-version": "${{ matrix.python }}"
          }
        },
        {
          "uses": "actions/download-artifact@v4",
          "with": {
            "name": "${{ matrix.artifact }}",
            "path": "dist"
          }
        },
        {
          "name": "Install the wheel",
          "shell": "bash",
          "run": "python -m pip install dist/*.whl"
        },
        {
          "name": "Import the extension",
          "shell": "bash",
          "run": "python -c \"import overrides._native\""
        }
      ]
    },
    "release": {
      "needs": "test",
      "if": "${{ github.ref == 'refs/heads/main' }}",
      "runs-on": "ubuntu-latest",
      "permissions": {
        "contents": "write"
      },
      "env": {
        "GH_TOKEN": "${{ github.token }}",
        "RELEASE": "wheels"
      },
      "steps": [
        {
          "uses": "actions/download-artifact@v4",
          "with": {
            "pattern": "wheel-*",
            "path": "dist",
            "merge-multiple": true
          }
        },
        {
          "name": "Replace the release with this commit's wheels",
          "run": "gh release delete \"$RELEASE\" --repo \"$GITHUB_REPOSITORY\" --yes --cleanup-tag || true\ngh release create \"$RELEASE\" dist/*.whl --repo \"$GITHUB_REPOSITORY\" --target \"$GITHUB_SHA\" --title \"Native wheels ($RELEASE)\" --notes \"The native wheels of $GITHUB_SHA, built and tested by $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID.\""
        }
      ]
    }
  }
}
