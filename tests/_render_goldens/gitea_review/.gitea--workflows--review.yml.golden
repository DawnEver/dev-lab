# Rendered by dev_lab.dev.ciworkflows from TOML (dev_lab/dev/ci_base.toml + [tool.dev_lab.ci] in pyproject.toml). Hand edits are refused; edit the TOML and run `python -m dev_lab.dev.ciworkflows render`.
{
  "name": "Review",
  "on": {
    "pull_request_target": {
      "types": [
        "labeled"
      ]
    }
  },
  "concurrency": {
    "group": "review-${{ github.event.pull_request.number }}-${{ github.event.label.name }}",
    "cancel-in-progress": true
  },
  "env": {
    "HEAD_SHA": "${{ github.event.pull_request.head.sha }}",
    "FAMILY_SOURCE": "https://github.com/DawnEver/",
    "UV_PYTHON": "python3",
    "UV_PYTHON_DOWNLOADS": "never",
    "UV_CONCURRENT_INSTALLS": "1",
    "UV_CONCURRENT_BUILDS": "1"
  },
  "jobs": {
    "review": {
      "if": "${{ (!(github.event.pull_request.draft || startsWith(github.event.pull_request.title, 'WIP:') || startsWith(github.event.pull_request.title, '[WIP]'))) && (github.event.label.name == 'review-due') }}",
      "runs-on": "review",
      "steps": [
        {
          "name": "Reach the forge on the runner's instance",
          "run": "[ -n \"$ACTIONS_RUNTIME_URL\" ] || { echo \"ACTIONS_RUNTIME_URL is unset: the runner names no forge to fetch from\"; exit 1; }\necho \"FORGE_URL=${ACTIONS_RUNTIME_URL%/api/actions_pipeline/}\" >> \"$GITHUB_ENV\"\necho \"GIT_CONFIG_GLOBAL=$RUNNER_TEMP/gitconfig\" >> \"$GITHUB_ENV\"\n"
        },
        {
          "name": "Settle a PR with no code to review",
          "id": "code",
          "env": {
            "GITHUB_TOKEN": "${{ github.token }}",
            "PR_NUMBER": "${{ github.event.pull_request.number }}",
            "BASE_SHA": "${{ github.event.pull_request.base.sha }}"
          },
          "run": "python3 -I -c 'import os, sys, tomllib, urllib.error, urllib.request\nenv = os.environ\napi = env[\"FORGE_URL\"] + \"/api/v1/repos/\" + env[\"GITHUB_REPOSITORY\"]\nauth = {\"Authorization\": \"token \" + env[\"GITHUB_TOKEN\"]}\ndef get(url, headers):\n    with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60) as reply:\n        return reply.read().decode(\"utf-8\")\nbase, path = env[\"BASE_SHA\"], \"src/dev_lab/dev/reviewcode.py\"\ntry:\n    lock = tomllib.loads(get(api + \"/raw/uv.lock?ref=\" + base, auth))\nexcept urllib.error.HTTPError as absent:\n    if absent.code != 404:\n        raise\n    lock = {\"package\": [{\"name\": \"dev-lab\", \"source\": {\"git\": \"#integrate/main\"}}]}  # no lock: the family line\n(source,) = [p[\"source\"] for p in lock.get(\"package\", []) if p[\"name\"] == \"dev-lab\"] or sys.exit(\"the base lock pins no dev-lab\")\nif \"git\" in source:\n    text = get(env[\"FAMILY_SOURCE\"] + \"dev-lab/raw/\" + source[\"git\"].rpartition(\"#\")[2] + \"/\" + path, {})\nelif source.get(\"editable\") == \".\":\n    text = get(api + \"/raw/\" + path + \"?ref=\" + base, auth)\nelse:\n    sys.exit(\"dev-lab is locked from %s, not a git revision\" % source)\nexec(compile(text, path, \"exec\"), {\"__name__\": \"__main__\"})' || echo \"settled=false\" >> \"$GITHUB_OUTPUT\"\n"
        },
        {
          "name": "Fetch the head",
          "env": {
            "FAMILY_READ_TOKEN": "${{ (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && secrets.FAMILY_READ_TOKEN || '' }}",
            "GITHUB_TOKEN": "${{ github.token }}"
          },
          "run": "export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=\"http.$FORGE_URL/.extraHeader\" GIT_CONFIG_VALUE_0=\"Authorization: basic $(printf 'x-access-token:%s' \"${FAMILY_READ_TOKEN:-$GITHUB_TOKEN}\" | base64 -w0)\"\ngit config --global url.\"$FORGE_URL/\".insteadOf \"${{ github.server_url }}/\"\ngit config --global pack.threads 1\ngit config --global core.hooksPath /dev/null\nREPO=\"$FORGE_URL/${{ github.repository }}.git\"\nMIRROR=\"$HOME/mirrors/${{ github.repository }}.git\"\nmkdir -p \"${MIRROR%/*}\"\n(\n  flock 9\n  if [ ! -d \"$MIRROR/objects\" ]; then\n    rm -rf \"$MIRROR.new\"\n    git clone -q --bare --template= --no-tags --filter=blob:none \"$REPO\" \"$MIRROR.new\"\n    mv \"$MIRROR.new\" \"$MIRROR\"\n  fi\n  find \"$MIRROR\" -maxdepth 2 -name '*.lock' -type f -delete\n  git -C \"$MIRROR\" remote set-url origin \"$REPO\"\n  git -C \"$MIRROR\" -c gc.auto=0 fetch -q --prune --no-tags --filter=blob:none origin '+refs/heads/*:refs/heads/*'\n  git -C \"$MIRROR\" repack -q -d --geometric=2\n) 9>\"$MIRROR.lock\"\ngit clone -q --shared --no-checkout --template= \"$MIRROR\" .\ngit remote set-url origin \"$REPO\"\ngit config core.repositoryformatversion 1\ngit config extensions.partialClone origin\ngit config remote.origin.promisor true\ngit config remote.origin.partialclonefilter blob:none\ngit fetch -q --no-tags --filter=blob:none origin '+refs/heads/*:refs/remotes/origin/*' \"+refs/pull/${{ github.event.pull_request.number || '*' }}/head:refs/remotes/origin/pull/${{ github.event.pull_request.number || '*' }}\"\ngit sparse-checkout set --cone\necho \"INTEGRATION_SHA=$(git rev-parse origin/integrate/main)\" >> \"$GITHUB_ENV\"\ngit checkout -q --detach \"${HEAD_SHA:-origin/integrate/main}\"\n",
          "if": "${{ steps.code.outputs.settled != 'true' }}"
        },
        {
          "name": "Install the review door",
          "run": "cd \"$RUNNER_TEMP\"\nexport GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=\"http.${FORGE_URL:-$GITHUB_SERVER_URL}/.extraHeader\" GIT_CONFIG_VALUE_0=\"Authorization: basic $(printf 'x-access-token:%s' \"${FAMILY_READ_TOKEN:-$GITHUB_TOKEN}\" | base64 -w0)\"\n[ -n \"$DOOR_SHA\" ] || { echo \"no commit names the door: no pull request base and no INTEGRATION_SHA\"; exit 1; }\n# A repo that locks no Python (a data repo) pins no door: the family's integration line is the door it runs.\nif ! git -C \"$GITHUB_WORKSPACE\" cat-file -e \"$DOOR_SHA:uv.lock\" 2>/dev/null; then DEV_LAB_REF=integrate/main; else\nDEV_LAB_REF=$(git -C \"$GITHUB_WORKSPACE\" show \"$DOOR_SHA:uv.lock\" | python3 -I -c 'import sys, tomllib\nlock = tomllib.loads(sys.stdin.read())\n(source,) = [p[\"source\"] for p in lock.get(\"package\", []) if p[\"name\"] == \"dev-lab\"] or sys.exit(\"the base lock pins no dev-lab\")\nif \"git\" in source:\n    print(source[\"git\"].rpartition(\"#\")[2])\nelif source.get(\"editable\") == \".\":\n    print(sys.argv[1])\nelse:\n    sys.exit(f\"dev-lab is locked from {source}, not a git revision\")' \"$DOOR_SHA\") || exit 1\nfi\ngit clone -q --no-tags --filter=blob:none --no-checkout \"${FAMILY_SOURCE}dev-lab.git\" \"$RUNNER_TEMP/dev-lab\"\ngit -C \"$RUNNER_TEMP/dev-lab\" fetch -q --no-tags origin \"$DEV_LAB_REF\"\ngit -C \"$RUNNER_TEMP/dev-lab\" checkout -q --detach FETCH_HEAD\npython3 -I -m venv \"$RUNNER_TEMP/review\" && \"$RUNNER_TEMP/review/bin/python\" -I -m pip install -q uv\n\"$RUNNER_TEMP/review/bin/uv\" export --no-config --project \"$RUNNER_TEMP/dev-lab\" --frozen --no-hashes --no-header --no-annotate --no-emit-project > \"$RUNNER_TEMP/review.txt\"\nif [ -n \"$DOOR_ONLY\" ]; then\ngrep -E \"^($DOOR_ONLY)( @ |==)\" \"$RUNNER_TEMP/review.txt\" > \"$RUNNER_TEMP/only.txt\" && [ \"$(wc -l < \"$RUNNER_TEMP/only.txt\")\" -eq \"$(echo \"$DOOR_ONLY\" | awk -F'|' '{print NF}')\" ] || { echo \"DOOR_ONLY=$DOOR_ONLY names a package the door's lock does not pin\"; exit 1; }\n\"$RUNNER_TEMP/review/bin/uv\" pip install --no-config --no-deps --python \"$RUNNER_TEMP/review/bin/python\" -r \"$RUNNER_TEMP/only.txt\"\nelse\n\"$RUNNER_TEMP/review/bin/uv\" pip install --no-config --python \"$RUNNER_TEMP/review/bin/python\" -r \"$RUNNER_TEMP/review.txt\"\nfi\n\"$RUNNER_TEMP/review/bin/uv\" pip install --no-config --python \"$RUNNER_TEMP/review/bin/python\" --no-deps \"$RUNNER_TEMP/dev-lab\"\necho \"REVIEW_PYTHON=$RUNNER_TEMP/review/bin/python\" >> \"$GITHUB_ENV\"\n",
          "env": {
            "DOOR_SHA": "${{ github.event.pull_request.base.sha || env.INTEGRATION_SHA }}",
            "FAMILY_READ_TOKEN": "${{ (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && secrets.FAMILY_READ_TOKEN || '' }}",
            "GITHUB_TOKEN": "${{ github.token }}"
          },
          "if": "${{ steps.code.outputs.settled != 'true' }}"
        },
        {
          "name": "Install the review method",
          "run": "cd \"$RUNNER_TEMP\"\nexport GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=\"http.${FORGE_URL:-$GITHUB_SERVER_URL}/.extraHeader\" GIT_CONFIG_VALUE_0=\"Authorization: basic $(printf 'x-access-token:%s' \"${FAMILY_READ_TOKEN:-$GITHUB_TOKEN}\" | base64 -w0)\"\npython3 -I -m venv \"$RUNNER_TEMP/ai-lab\" && \"$RUNNER_TEMP/ai-lab/bin/python\" -I -m pip install -q uv\nAI_LAB_REV=$(python3 -I -c 'import sys, tomllib\nlock = tomllib.loads(sys.stdin.read())\n(source,) = [p[\"source\"] for p in lock.get(\"package\", []) if p[\"name\"] == \"ai-lab\"] or sys.exit(\"the door lock pins no ai-lab\")\n\"git\" in source or sys.exit(f\"ai-lab is locked from {source}, not a git revision\")\nprint(source[\"git\"].rpartition(\"#\")[2])' < \"$RUNNER_TEMP/dev-lab/uv.lock\") || exit 1\ngit clone -q --no-tags --filter=blob:none --no-checkout \"${FAMILY_SOURCE}ai-lab.git\" \"$RUNNER_TEMP/ai-lab-src\"\ngit -C \"$RUNNER_TEMP/ai-lab-src\" fetch -q --no-tags origin \"$AI_LAB_REV\"\ngit -C \"$RUNNER_TEMP/ai-lab-src\" checkout -q --detach \"$AI_LAB_REV\"\n\"$RUNNER_TEMP/ai-lab/bin/uv\" export --no-config --project \"$RUNNER_TEMP/ai-lab-src\" --frozen --no-hashes --no-header --no-annotate --no-emit-project > \"$RUNNER_TEMP/ai-lab.txt\"\n\"$RUNNER_TEMP/ai-lab/bin/uv\" pip install --no-config --no-deps --python \"$RUNNER_TEMP/ai-lab/bin/python\" -r \"$RUNNER_TEMP/ai-lab.txt\"\n\"$RUNNER_TEMP/ai-lab/bin/uv\" pip install --no-config --no-deps --python \"$RUNNER_TEMP/ai-lab/bin/python\" \"$RUNNER_TEMP/ai-lab-src\"\n",
          "env": {
            "FAMILY_READ_TOKEN": "${{ (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && secrets.FAMILY_READ_TOKEN || '' }}",
            "GITHUB_TOKEN": "${{ github.token }}"
          },
          "if": "${{ steps.code.outputs.settled != 'true' }}"
        },
        {
          "name": "Keep the review keys in memory",
          "run": "git config --global credential.helper \"cache --timeout=1800 --socket=$RUNNER_TEMP/git-credential-cache/socket\"",
          "if": "${{ steps.code.outputs.settled != 'true' }}"
        },
        {
          "name": "Hand the forge tokens to the door",
          "run": "umask 077\nmkdir -p \"$RUNNER_TEMP/forge-secrets\"\nprintf '%s' \"${FAMILY_READ_TOKEN:-$GITHUB_TOKEN}\" > \"$RUNNER_TEMP/forge-secrets/read\"\nprintf '%s' \"$GITHUB_TOKEN\" > \"$RUNNER_TEMP/forge-secrets/api\"\n",
          "env": {
            "FAMILY_READ_TOKEN": "${{ (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && secrets.FAMILY_READ_TOKEN || '' }}",
            "GITHUB_TOKEN": "${{ github.token }}"
          },
          "if": "${{ steps.code.outputs.settled != 'true' }}"
        },
        {
          "name": "tests/review",
          "run": "trap 'git credential-cache --socket=$RUNNER_TEMP/git-credential-cache/socket exit; rm -rf \"$RUNNER_TEMP/forge-secrets\"' EXIT\n\"$REVIEW_PYTHON\" -I -m dev_lab.dev.forge review run --pr ${{ github.event.pull_request.number || inputs.pr }} --keys-env AI_LAB_KEYS_PR_REVIEW --git-token-file \"$RUNNER_TEMP/forge-secrets/read\" --api-token-file \"$RUNNER_TEMP/forge-secrets/api\" --runtime \"ai_lab.python=$RUNNER_TEMP/ai-lab/bin/python\"\n",
          "env": {
            "AI_LAB_KEYS_PR_REVIEW": "${{ (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && secrets.AI_LAB_KEYS_PR_REVIEW || '' }}"
          },
          "if": "${{ steps.code.outputs.settled != 'true' }}"
        }
      ],
      "permissions": {
        "actions": "read",
        "contents": "write",
        "pull-requests": "write",
        "issues": "write"
      }
    }
  }
}
